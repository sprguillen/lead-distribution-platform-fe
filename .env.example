# REQUIRED. Internal address of the backend API. The app refuses to serve
# without it rather than guessing a port and failing silently.
#
# Not prefixed with NEXT_PUBLIC_ on purpose: that prefix inlines the value into
# the browser bundle, which would both publish the internal port and break the
# runtime override. This is read server-side at request time, so changing it
# needs a restart, not a rebuild.
API_URL="http://127.0.0.1:4000"
